# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret : ne jamais exposer côté client. Utilisé uniquement par les routes
# serveur (contenu de session sans les bonnes réponses, espace parent).
SUPABASE_SERVICE_ROLE_KEY=

# Emails transactionnels (Resend). Sans clé, les emails sont écrits dans la
# console du serveur au lieu d'être envoyés : pratique en local, refusé au
# build en production (cf. verifierConfigurationEmail).
RESEND_API_KEY=
EMAIL_EXPEDITEUR="Admissible <onboarding@resend.dev>"

# Base des liens envoyés par email (confirmation, accès parent). Doit être
# l'URL publique en production, sans quoi les liens pointeront vers localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
